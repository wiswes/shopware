<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
           http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- ===== Phase 1 ===================================================== -->

        <service id="Wiswes\Widget\Service\ConfigReader">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Wiswes\Widget\Storefront\Subscriber\WidgetInjectionSubscriber">
            <argument type="service" id="Wiswes\Widget\Service\ConfigReader"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Wiswes\Widget\Controller\Admin\InstallController" public="true">
            <argument type="service" id="Wiswes\Widget\Service\ConfigReader"/>
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- ===== Phase 2: PHP-side MCP endpoints chat_agent calls into ====== -->

        <!-- Bearer-token gate. Every /api/_mcp/wiswes/* request must include
             `Authorization: Bearer <tenantSecret>` where tenantSecret matches
             the value the install handshake stored in system_config. Anything
             else gets 401 before the controller runs. -->
        <service id="Wiswes\Widget\Mcp\Http\BearerTokenSubscriber">
            <argument type="service" id="Wiswes\Widget\Service\ConfigReader"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Cart tool surface. Mirrors Magento's Mcp/Tool/Cart/{Info,Add,
             Update,Remove}Tool — but each is one Symfony route delegating
             to Shopware's CartService instead of an in-process MCP server. -->
        <service id="Wiswes\Widget\Controller\Mcp\CartController" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextService"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\LineItemFactoryRegistry"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
