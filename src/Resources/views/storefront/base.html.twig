{% sw_extends '@Storefront/storefront/base.html.twig' %}

{# Storefront subscriber sets `wiswesWidget` on the render context when
   the merchant has completed the install flow + has the storefront
   toggle enabled. If either condition fails, the parameter is null
   and we render nothing. #}

{% block base_body_inner %}
    {{ parent() }}

    {% if wiswesWidget is defined and wiswesWidget.enabled %}
        <script src="{{ wiswesWidget.baseUrl }}/api/widget/embed.js?user_token={{ wiswesWidget.token|escape('url') }}" async></script>
    {% endif %}
{% endblock %}
