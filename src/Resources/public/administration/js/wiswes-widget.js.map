export default "{% block wiswes_widget_status %}\n<sw-page class=\"wiswes-widget-status\">\n    <template #smart-bar-header>\n        <h2>{{ $tc('wiswes-widget.status.title') }}</h2>\n    </template>\n\n    <template #content>\n        <sw-card-view v-if=\"!loading\">\n            {# ----- Not yet connected: show form + install button ----- #}\n            <sw-card v-if=\"!snapshot.isInstalled\" :title=\"$tc('wiswes-widget.status.notConnectedHeading')\">\n                <p class=\"sw-mb-m\">{{ $tc('wiswes-widget.status.notConnectedBody') }}</p>\n\n                <sw-text-field\n                    v-model=\"shopUrl\"\n                    :label=\"$tc('wiswes-widget.status.shopUrlLabel')\"\n                    :placeholder=\"$tc('wiswes-widget.status.shopUrlPlaceholder')\"\n                />\n\n                <sw-text-field\n                    v-model=\"adminEmail\"\n                    :label=\"$tc('wiswes-widget.status.adminEmailLabel')\"\n                    :placeholder=\"$tc('wiswes-widget.status.adminEmailPlaceholder')\"\n                    type=\"email\"\n                />\n\n                <sw-button\n                    variant=\"primary\"\n                    :is-loading=\"installing\"\n                    :disabled=\"installing || !adminEmail\"\n                    @click=\"install\"\n                >\n                    {{ installing ? $tc('wiswes-widget.status.installInProgress') : $tc('wiswes-widget.status.installButton') }}\n                </sw-button>\n            </sw-card>\n\n            {# ----- Connected: show status + manage links ----- #}\n            <sw-card v-else :title=\"$tc('wiswes-widget.status.connectedHeading')\">\n                <p class=\"sw-mb-m\">{{ $tc('wiswes-widget.status.connectedBody') }}</p>\n\n                <sw-description-list>\n                    <dt>{{ $tc('wiswes-widget.status.tenantSlugLabel') }}</dt>\n                    <dd>{{ snapshot.tenantSlug }}</dd>\n                </sw-description-list>\n\n                <div class=\"wiswes-widget-status__actions\">\n                    <sw-button\n                        variant=\"primary\"\n                        :link=\"dashboardUrl\"\n                        target=\"_blank\"\n                    >\n                        {{ $tc('wiswes-widget.status.openDashboardButton') }}\n                    </sw-button>\n\n                    <sw-button\n                        variant=\"danger\"\n                        :is-loading=\"disconnecting\"\n                        :disabled=\"disconnecting\"\n                        @click=\"disconnect\"\n                    >\n                        {{ $tc('wiswes-widget.status.disconnectButton') }}\n                    </sw-button>\n                </div>\n            </sw-card>\n        </sw-card-view>\n\n        <sw-loader v-else />\n    </template>\n</sw-page>\n{% endblock %}\n";