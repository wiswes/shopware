{
    "name": "wiswes/shopware-mcp",
    "description": "WisWes chat widget integration for Shopware 6 — one-click connect, storefront script injection, PHP MCP endpoints (cart, catalog, checkout, orders), admin status page",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "version": "0.3.0",
    "homepage": "https://wiswes.com",
    "support": {
        "issues": "https://github.com/wiswes/shopware/issues",
        "source": "https://github.com/wiswes/shopware",
        "docs": "https://wiswes.com/install/shopware",
        "email": "services@wiswes.com"
    },
    "keywords": ["shopware", "shopware6", "shopware-6", "mcp", "model-context-protocol", "wiswes", "ecommerce", "ai", "chatbot", "chat-widget"],
    "require": {
        "shopware/core": "~6.5.0|~6.6.0",
        "shopware/storefront": "~6.5.0|~6.6.0",
        "shopware/administration": "~6.5.0|~6.6.0"
    },
    "autoload": {
        "psr-4": {
            "Wiswes\\Widget\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Wiswes\\Widget\\WiswesWidget",
        "label": {
            "en-GB": "WisWes Chat Widget",
            "de-DE": "WisWes Chat Widget"
        },
        "description": {
            "en-GB": "Embeds the WisWes AI shopping assistant on the storefront. One-click connect from Settings → WisWes."
        }
    }
}
