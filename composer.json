{
    "name": "wiswes/widget",
    "description": "WisWes chat widget injection for Shopware storefront",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.5.0"
    },
    "autoload": {
        "psr-4": {
            "Wiswes\\Widget\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Wiswes\\Widget\\WiswesWidget",
        "label": {
            "en-GB": "WisWes Chat Widget",
            "de-DE": "WisWes Chat Widget"
        },
        "description": {
            "en-GB": "Embeds the WisWes chat widget into the storefront."
        }
    }
}
